# `files/` was excluded here while the handouts were third-party material on a
# public repository. The author decided to publish them, so the rule is gone and
# docs/spec/14 §0 records the reversal. Restoring one line brings it back.

# Layer 1 working tree. `layer1/data/` is tracked deliberately (#41), apart
# from the per-run output; the other three are a virtualenv, vendored arms and
# a test cache.
/layer1/.venv/
/layer1/.arms/
/layer1/.pytest_cache/
/layer1/data/runs/

# Word writes a lock file next to an open document, and build_pcc.py fails on
# it with PermissionError.
~$*.docx

__pycache__/
*.py[cod]
.venv/

# `data/` at the repository root is left visible on purpose: it is experiment
# output the author may want to commit, and hiding it would decide that here.

# Omoikane wiki runtime (template).
.obsidian/workspace*.json
.obsidian/cache
.trash/
.wiki-ingest.log
